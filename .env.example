# HealthLink sender service — copy to .env and fill in.
# Loaded with `node --env-file=.env` (npm start).

# HMS client folders. The client (C:\HLINK by default, see hms_config.xml)
# keeps one folder per MESSAGE TYPE:
#   HL7_out\<TYPE>            where we drop messages     (processDir)
#   HL7_out\<TYPE>\rejected   files it refused to send   (processErrorDir)
#   HL7_in\<TYPE>             where ACKs arrive          (deprocessAckDir)
#   HL7_in\<TYPE>\rejected    inbound it could not read  (deprocessErrorDir)
# <TYPE> is the message type HealthLink assigns to our ORU results — ask
# HealthLink which one and point both paths at it.
HL7_OUT_PATH=C:\HLINK\HL7_out\<TYPE>
HL7_IN_PATH=C:\HLINK\HL7_in\<TYPE>
# The two rejected folders default to <path>\rejected as above.
#HL7_OUT_REJECTED_PATH=
#HL7_IN_REJECTED_PATH=

# Our own folders, kept OUTSIDE the client's tree, on the same drive.
# Defaults: C:\HLINK\vasciq-staging (write-then-rename into HL7_out) and
# C:\HLINK\vasciq-archive (processed/, other/, rejected/ — never deleted).
#STAGING_PATH=
#ARCHIVE_PATH=

# Inbound auth — VascIQ sends this in the x-api-key header
# (same value as HEALTHLINK_SENDER_API_KEY in Vercel)
API_KEY=

# Where ACKs are reported — the VascIQ webhook and its shared secret
# (same value as HEALTHLINK_WEBHOOK_SECRET in Vercel)
VASCIQ_WEBHOOK_URL=https://app.vasciq.ai/api/delivery/ack
VASCIQ_WEBHOOK_SECRET=

# Listening port / address. Use TLS below, or put the service behind a
# load balancer that terminates HTTPS. 127.0.0.1 keeps it local-only.
PORT=8443
HOST=0.0.0.0
#TLS_CERT_PATH=C:\healthlink-sender\certs\fullchain.pem
#TLS_KEY_PATH=C:\healthlink-sender\certs\privkey.pem

# Alerts (email). Leave SMTP blank to log alerts only.
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Tuning (defaults shown)
#WATCH_INTERVAL_MS=30000
#STUCK_FILE_MINUTES=30
#WEBHOOK_FAILING_MINUTES=15
#DB_PATH=data\sender.db
#LOG_PATH=logs\sender.log
