# HealthLink sender service — copy to .env and fill in.
# Loaded with `node --env-file=.env` (npm start).

# HMS client folders (from the HealthLink install)
HL7_OUT_PATH=C:\HLINK\HL7_out
HL7_IN_PATH=C:\HLINK\HL7_in
# Messages are written here first, then renamed into HL7_out so the HMS
# client never sees a half-written file. Must be on the same drive.
# Default: a "hl7-staging" folder beside HL7_out.
#STAGING_PATH=C:\HLINK\hl7-staging

# Inbound auth — VascIQ sends this in the x-api-key header
# (same value as HEALTHLINK_SENDER_API_KEY in Vercel)
API_KEY=

# Where ACKs are reported — the VascIQ webhook and its shared secret
# (same value as HEALTHLINK_WEBHOOK_SECRET in Vercel)
VASCIQ_WEBHOOK_URL=https://app.vasciq.ai/api/delivery/ack
VASCIQ_WEBHOOK_SECRET=

# Listening port / address. Use TLS below, or put the service behind a
# load balancer that terminates HTTPS. 127.0.0.1 keeps it local-only.
PORT=8443
HOST=0.0.0.0
#TLS_CERT_PATH=C:\healthlink-sender\certs\fullchain.pem
#TLS_KEY_PATH=C:\healthlink-sender\certs\privkey.pem

# Alerts (email). Leave SMTP blank to log alerts only.
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Tuning (defaults shown)
#WATCH_INTERVAL_MS=30000
#STUCK_FILE_MINUTES=30
#WEBHOOK_FAILING_MINUTES=15
#DB_PATH=data\sender.db
#LOG_PATH=logs\sender.log
